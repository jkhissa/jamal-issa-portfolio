---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Jamal Issa | Senior Technical Business Analyst',
  description = 'Jamal Issa is a Senior Technical Business Analyst specialising in Identity & Access Management, fintech systems, and Agile delivery — with an international career spanning Russia, Syria, and Scotland.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Jamal Issa" />
    <meta name="keywords" content="Jamal Issa, Business Analyst, Technical Business Analyst, Identity Access Management, IAM, MS Entra Suite, Avaloq, Agile, fintech, Edinburgh, Slovakia" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Space+Grotesk:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0a0a0a] text-[#e0e0e0] font-sans leading-relaxed overflow-x-hidden">
    <slot />
  </body>
</html>
