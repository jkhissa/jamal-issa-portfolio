---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  surface?: 'dark' | 'light';
  active?: 'home' | 'writing' | 'profile' | 'now';
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Jamal Issa is a Senior Technical Business Analyst specialising in Identity & Access Management on Microsoft\'s identity platform — Azure AD B2C, Entra External ID and Entra ID Governance, OAuth 2.0 / OIDC — based in Edinburgh.',
  surface = 'light',
  active,
  type = 'website',
} = Astro.props;

const fullTitle = title ? `${title} — Jamal Issa` : 'Jamal Issa | Senior Technical Business Analyst';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-surface={surface}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jamal Issa" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content={surface === 'dark' ? '#0b0c10' : '#fbfaf7'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Jamal Issa — Writing" href="/rss.xml" />
    {surface === 'light' && (
      <script is:inline>
        // Apply the reader's saved theme before first paint (no flash).
        try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    {surface === 'light' && <div class="wash" aria-hidden="true"></div>}
    <slot name="background" />
    <Header active={active} showToggle={surface === 'light'} />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
