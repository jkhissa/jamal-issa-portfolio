---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="page-top"><div class="wrap grid">
    <div class="kicker label">Error 404</div>
    <h1 class="display">This page doesn't exist<span class="dot">.</span></h1>
    <p class="standfirst">It may have moved, or the link may be wrong. Try the <a href="/">home page</a> or the <a href="/writing/">writing</a> section.</p>
  </div></div>
</Base>
