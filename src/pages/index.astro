---
import Base from '../layouts/Base.astro';
import GlassBackground from '../components/GlassBackground.astro';
import Ticker from '../components/Ticker.astro';
import NowList from '../components/NowList.astro';
import { now, stageOrder } from '../data/now';
import { headline, employer, platforms, certifications, languages, links } from '../data/profile';
import { getPosts, readingMinutes, formatDate } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
const nowItems = [...now].sort((a, b) => stageOrder.indexOf(a.stage) - stageOrder.indexOf(b.stage)).slice(0, 4);
---

<Base surface="dark" active="home">
  <GlassBackground slot="background" />

  <div class="bento">
    <section class="t hero glass solid" aria-labelledby="hero-title">
      <div class="who"><span class="pulse" aria-hidden="true"></span>{headline} · {employer}</div>
      <h1 id="hero-title">I design how people and machines <em>access</em> what they need, and what they can do next.</h1>
      <p>Identity &amp; access management on Microsoft's platform: Azure AD B2C, Entra and OAuth 2.0 / OIDC, from first workshop to go-live.</p>
    </section>

    <a class="t now glass solid" href="/now/">
      <span class="label">Now</span><span class="go" aria-hidden="true">↗</span>
      <h2 class="tt">What I'm working on</h2>
      <NowList items={nowItems} />
    </a>

    <div class="t stat glass"><span class="label">Experience</span><div class="n">14<b>+</b></div><span class="d">years in business &amp; technical analysis</span></div>
    <div class="t stat glass"><span class="label">Identity</span><div class="n">3<b>+</b></div><span class="d">years in IAM &amp; CIAM</span></div>

    <a class="t writing glass solid" href="/writing/">
      <span class="label">Latest writing</span><span class="go" aria-hidden="true">↗</span>
      <h2 class="tt">Notes &amp; articles</h2>
      {posts.length > 0 ? posts.map(post => (
        <span class="post">
          <b>{post.data.title}</b>
          <span>{post.data.topic} · {formatDate(post.data.date)} · {readingMinutes(post.body)} min</span>
        </span>
      )) : (
        <p class="empty">First articles on identity, delivery and homelab projects are on the way.</p>
      )}
    </a>

    <div class="t wide glass">
      <span class="label">Platforms &amp; standards</span>
      <div class="tags">{platforms.map(p => <span>{p}</span>)}</div>
    </div>

    <a class="t col glass" href="/profile/#certifications">
      <span class="label">Certifications · {certifications.length}</span>
      <div class="badges">{certifications.filter(c => c.issuer !== 'Boot.dev').map(c => <span>{c.short}</span>)}</div>
    </a>
    <div class="t col glass"><span class="label">Based in</span><div><div class="word">Edinburgh</div><span class="sub mono">Scotland, UK</span></div></div>

    <div class="t col glass"><span class="label">Languages · 3 countries</span><div class="langs">{languages.map(l => <span title={`${l.name}: ${l.level}`}>{l.code}</span>)}</div></div>
    <a class="t col glass" href="/profile/"><span class="label">Previously</span><div><div class="word">Avaloq</div><span class="sub">4 yrs · core banking lending</span></div></a>

    <div class="ticker-wrap glass"><Ticker items={platforms} /></div>

    <section class="t contact glass solid" aria-label="Contact">
      <div class="big">Working on identity?<br /><a href={links.email}>Let's talk →</a></div>
      <div class="btns">
        <a class="btn primary" href={links.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        <a class="btn" href={links.github} target="_blank" rel="me noopener">GitHub</a>
        <a class="btn" href="/rss.xml">RSS</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .bento {
    max-width: 1200px; margin: 0 auto; padding: 22px 24px 40px;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px;
  }
  .bento > * { min-width: 0; } /* stop the ticker's long line widening the grid */

  /* Glass: one treatment for every tile */
  .glass {
    background: var(--glass); border: 1px solid var(--edge); border-radius: 22px;
    box-shadow: inset 0 1px 0 var(--edge-top), 0 20px 50px rgba(0, 0, 0, .25);
    -webkit-backdrop-filter: blur(var(--blur)) saturate(140%);
    backdrop-filter: blur(var(--blur)) saturate(140%);
  }
  .glass.solid { background: var(--glass-solid); } /* text-heavy tiles: more opaque = more readable */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass, .glass.solid { background: #181a22; }
  }

  .t { position: relative; min-height: 168px; padding: 24px; color: var(--text); text-decoration: none; transition: transform .25s, border-color .25s; }
  a.t:hover { transform: translateY(-3px); border-color: rgba(255, 255, 255, .18); }
  .go {
    position: absolute; top: 20px; right: 20px; width: 34px; height: 34px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(255, 255, 255, .08); color: var(--text-2);
    transition: background .2s, color .2s;
  }
  a.t:hover .go { background: var(--accent); color: #0b0c10; }
  .tt { margin: 8px 0 14px; font: 700 22px/1.2 var(--font-display); letter-spacing: -.02em; }

  .hero { grid-column: span 2; grid-row: span 2; min-height: 350px; padding: 30px; display: flex; flex-direction: column; justify-content: space-between; gap: 28px; }
  .hero h1 { margin: 0; font: 900 clamp(40px, 5vw, 60px)/.98 var(--font-display); letter-spacing: -.045em; text-wrap: balance; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .hero p { margin: 0; color: var(--text-2); font-size: 17.5px; line-height: 1.6; max-width: 46ch; }
  .who { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgba(255, 107, 74, .18); }

  .now, .writing { grid-column: span 2; grid-row: span 2; }

  .post { display: block; padding: 14px 0; border-top: 1px solid rgba(255, 255, 255, .07); }
  .post:first-of-type { border-top: 0; }
  .post b { display: block; margin-bottom: 4px; font: 600 18px/1.3 var(--font-display); letter-spacing: -.01em; }
  a.writing:hover .post b { color: var(--accent); }
  .post span { color: var(--text-3); font: 13px var(--font-mono); }
  .empty { margin: 0; color: var(--text-2); font-size: 16px; max-width: 36ch; }

  .stat { display: flex; flex-direction: column; justify-content: space-between; }
  .stat .n { font: 900 60px/1 var(--font-display); letter-spacing: -.05em; }
  .stat .n b { color: var(--accent); }
  .stat .d { color: var(--text-2); font-weight: 500; }

  .wide { grid-column: span 2; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .tags span { padding: 6px 12px; border-radius: 99px; font-size: 14px; font-weight: 500; background: rgba(255, 255, 255, .06); border: 1px solid var(--edge); }

  .col { display: flex; flex-direction: column; justify-content: space-between; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .badges span { font: 500 12.5px var(--font-mono); padding: 5px 9px; border-radius: 8px; background: rgba(255, 255, 255, .08); }
  .word { font: 800 28px var(--font-display); letter-spacing: -.03em; }
  .sub { color: var(--text-2); font-size: 14px; }
  .langs { display: flex; gap: 8px; }
  .langs span { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; font: 700 15px var(--font-display); background: rgba(255, 255, 255, .07); border: 1px solid var(--edge); }

  .ticker-wrap { grid-column: 1 / -1; border-radius: 10px; }

  .contact { grid-column: 1 / -1; min-height: 0; padding: 32px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .big { font: 900 clamp(30px, 4vw, 46px)/1.05 var(--font-display); letter-spacing: -.04em; }
  .big a { color: inherit; text-decoration: none; border-bottom: 4px solid var(--accent); }
  .big a:hover { color: var(--accent); }
  .btns { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn { padding: 12px 20px; border-radius: 12px; font-weight: 600; color: var(--text); text-decoration: none; background: rgba(255, 255, 255, .08); border: 1px solid var(--edge); }
  .btn:hover { background: rgba(255, 255, 255, .14); }
  .btn.primary { background: var(--accent); border-color: transparent; color: #0b0c10; } /* dark text: 6.9:1 */

  @media (max-width: 980px) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) {
    .bento { grid-template-columns: minmax(0, 1fr); padding: 16px 12px 32px; --blur: 14px; }
    .t, .hero, .now, .writing, .wide { grid-column: auto; grid-row: auto; }
    .hero { min-height: 0; }
    .t { min-height: 0; }
    .col, .stat { gap: 18px; }
  }
</style>
