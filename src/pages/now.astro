---
import Base from '../layouts/Base.astro';
import NowList from '../components/NowList.astro';
import { now, stageOrder } from '../data/now';

const active = now.filter(i => i.stage !== 'done').sort((a, b) => stageOrder.indexOf(a.stage) - stageOrder.indexOf(b.stage));
const done = now.filter(i => i.stage === 'done');
const lastUpdated = now.map(i => i.updated).sort().at(-1);
---

<Base title="Now" description="What Jamal Issa is working on right now." active="now">
  <div class="page-top"><div class="wrap grid">
    <div class="kicker label">Now · updated {lastUpdated}</div>
    <h1 class="display">What I'm working on<span class="dot">.</span></h1>
    <p class="standfirst">Current projects outside the day job, from planning to done. Each bar shows how much of the project's checklist is complete.</p>
  </div></div>

  <section class="section" aria-labelledby="in-progress"><div class="wrap grid">
    <div class="section-label"><span class="num">01</span><h2 id="in-progress">In progress</h2></div>
    <div class="section-body"><NowList items={active} detailed /></div>
  </div></section>

  {done.length > 0 && (
    <section class="section" aria-labelledby="done"><div class="wrap grid">
      <div class="section-label"><span class="num">02</span><h2 id="done">Recently done</h2></div>
      <div class="section-body"><NowList items={done} detailed /></div>
    </div></section>
  )}
</Base>
