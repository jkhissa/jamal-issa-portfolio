---
import Base from '../layouts/Base.astro';
import { jobs, skills, certifications, languages, education, links } from '../data/profile';
---

<Base title="Profile" description="Experience, skills and certifications of Jamal Issa, Senior Technical Business Analyst in identity and access management." active="profile">
  <div class="page-top"><div class="wrap grid">
    <div class="kicker label">Profile</div>
    <h1 class="display">Profile<span class="dot">.</span></h1>
    <p class="standfirst">
      Senior Technical Business Analyst specialising in identity and access management on Microsoft's platform.
      Across ~14 years, I frame the real problem, bring the right people into the room, and turn requirements and
      regulation into specifications engineers can build from.
    </p>
  </div></div>

  <section class="section" aria-labelledby="experience"><div class="wrap grid">
    <div class="section-label"><span class="num">01</span><h2 id="experience">Experience</h2></div>
    <div class="section-body">
      {jobs.map(job => (
        <article class="job">
          <div class="label when">{job.date}</div>
          <div>
            <h3>{job.title}</h3>
            <p class="org">{job.companyName} · {job.location}</p>
            {job.bullets.length > 0 && <ul>{job.bullets.map(b => <li>{b}</li>)}</ul>}
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <section class="section" aria-labelledby="skills"><div class="wrap grid">
    <div class="section-label"><span class="num">02</span><h2 id="skills">Skills</h2></div>
    <div class="section-body split">
      <div><h3 class="label sub">Core</h3><div class="chips">{skills.core.map(s => <span class="chip">{s}</span>)}</div></div>
      <div><h3 class="label sub">Technical</h3><div class="chips">{skills.technical.map(s => <span class="chip">{s}</span>)}</div></div>
    </div>
  </div></section>

  <section class="section" aria-labelledby="certifications"><div class="wrap grid">
    <div class="section-label"><span class="num">03</span><h2 id="certifications">Certifications</h2></div>
    <div class="section-body">
      <table class="table">
        <thead><tr><th>Certification</th><th>Issuer</th><th>Year</th></tr></thead>
        <tbody>
          {certifications.map(c => (
            <tr><td><strong>{c.short}</strong> <span class="muted">{c.name}</span></td><td>{c.issuer}</td><td class="mono">{c.year}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div></section>

  <section class="section" aria-labelledby="education"><div class="wrap grid">
    <div class="section-label"><span class="num">04</span><h2 id="education">Education &amp; languages</h2></div>
    <div class="section-body split">
      <div>
        <h3 class="label sub">Education</h3>
        {education.map(e => <p class="edu"><strong>{e.degree}</strong><br /><span class="muted">{e.school} · {e.years}</span></p>)}
      </div>
      <div>
        <h3 class="label sub">Languages</h3>
        <ul class="langs">{languages.map(l => <li><strong>{l.name}</strong><span class="muted">{l.level}</span></li>)}</ul>
      </div>
    </div>
  </div></section>

  <section class="section cta"><div class="wrap grid">
    <p class="big">Working on identity? <a href={links.email}>Let's talk →</a></p>
  </div></section>
</Base>

<style>
  .job { display: grid; grid-template-columns: 170px 1fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--hair); }
  .job:first-child { border-top: 2px solid var(--rule); }
  .when { padding-top: 5px; }
  .job h3 { margin: 0; font: 800 22px/1.25 var(--font-display); letter-spacing: -.02em; }
  .org { margin: 4px 0 0; color: var(--text-2); }
  .job ul { margin: 12px 0 0; padding-left: 1.15em; color: var(--text); max-width: 70ch; }
  .job li { margin-bottom: 6px; }
  .job li::marker { color: var(--accent); }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .sub { margin: 0 0 14px; }
  .muted { color: var(--text-2); }

  .table { width: 100%; border-collapse: collapse; font-size: 16px; }
  .table th { text-align: left; font: 500 12px var(--font-mono); text-transform: uppercase; letter-spacing: .05em; color: var(--text-3); border-bottom: 2px solid var(--rule); padding: 8px 14px 8px 0; }
  .table td { border-bottom: 1px solid var(--hair); padding: 12px 14px 12px 0; vertical-align: top; }
  .table strong { margin-right: 6px; }

  .edu { margin: 0 0 16px; }
  .langs { list-style: none; margin: 0; padding: 0; }
  .langs li { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--hair); }

  .cta .big { grid-column: 1 / -1; margin: 0; font: 900 clamp(32px, 5vw, 60px)/1 var(--font-display); letter-spacing: -.045em; }
  .cta .big a { color: inherit; text-decoration: none; border-bottom: 6px solid var(--accent); }
  .cta .big a:hover { color: var(--accent); }

  @media (max-width: 760px) {
    .job { grid-template-columns: 1fr; gap: 6px; }
    .split { grid-template-columns: 1fr; gap: 28px; }
    .table th:nth-child(2), .table td:nth-child(2) { display: none; }
  }
</style>
