---
const stats = [
  { number: '10+',       label: 'Years Experience' },
  { number: 'MSc & BSc', label: 'Degrees'           },
  { number: '4',         label: 'Languages'         },
  { number: 'Slovakia',  label: 'Relocating to'     },
];
---

<section id="about" class="py-28 px-8 flex items-center justify-center">
  <div class="max-w-5xl w-full mx-auto">
    <h2 class="font-heading text-4xl font-bold text-center text-accent mb-14">About Me</h2>

    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div class="space-y-5 text-[1.05rem] leading-relaxed opacity-90">
        <p>
          I'm a Senior Technical Business Analyst with over ten years of experience bridging
          business strategy and technical delivery. I specialise in Identity & Access Management,
          fintech systems, and Agile delivery — helping organisations translate complex requirements
          into clear, scalable solutions.
        </p>
        <p>
          My career has been shaped by an international journey: born in Russia, raised in Syria,
          I moved to Edinburgh to pursue my MSc in Business Information Technology at Edinburgh
          Napier University — and built my professional career there over the following decade,
          working with organisations such as Avaloq and Condatis on identity, access management,
          and regulatory compliance projects. I'm now relocating to Slovakia to establish my
          personal brand and consultancy.
        </p>
        <p>
          Fluent in English, Arabic, Russian, and French, I bring cross-cultural fluency to every
          engagement — whether facilitating stakeholder workshops, navigating complex requirements,
          or aligning distributed teams around a shared vision.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-5">
        {stats.map(stat => (
          <div class="bg-white/5 p-8 rounded-2xl text-center border border-white/10 transition-all duration-300 hover:-translate-y-1 hover:bg-white/10">
            <span class="block text-3xl font-bold text-accent mb-2">{stat.number}</span>
            <span class="text-sm opacity-70">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
