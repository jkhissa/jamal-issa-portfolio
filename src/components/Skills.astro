---
const categories = [
  {
    name: 'Core Skills',
    tags: [
      'IT Business Analysis', 'Service Delivery', 'User Stories',
      'Stakeholder Engagement', 'Requirement Gathering',
      'Specification Design', 'Agile Practitioner',
    ],
  },
  {
    name: 'Technical',
    tags: [
      'Microsoft Office', 'Visio', 'Creatly', 'UXPin',
      'SAP PowerDesigner', 'HTML5', 'CSS3', 'JavaScript',
      'Azure Fundamentals',
    ],
  },
  {
    name: 'Languages',
    tags: [
      'English (Full Professional)', 'Arabic (Native)',
      'Russian (Native)', 'French (Elementary)',
    ],
  },
];
---

<section id="skills" class="py-28 px-8 flex items-center justify-center">
  <div class="max-w-5xl w-full mx-auto">
    <h2 class="font-heading text-4xl font-bold text-center text-accent mb-14">Skills & Certifications</h2>

    <div class="grid md:grid-cols-3 gap-6">
      {categories.map(cat => (
        <div class="bg-white/5 p-8 rounded-2xl border border-white/5">
          <h3 class="text-accent font-semibold mb-6 text-lg">{cat.name}</h3>
          <div class="flex flex-wrap gap-2.5">
            {cat.tags.map(tag => (
              <span class="bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm border border-accent/20 cursor-default transition-all duration-300 hover:bg-accent hover:text-white">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
