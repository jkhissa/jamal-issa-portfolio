---
const categories = [
  {
    name: 'Core Skills',
    tags: [
      'Stakeholder Management', 'Customer Identity & Access Management',
      'Requirements & Specification', 'Discovery Workshops',
      'Solution Design', 'Agile Delivery',
    ],
  },
  {
    name: 'Technical',
    tags: [
      'Azure AD B2C (Custom Policies / IEF)', 'Entra External ID',
      'Entra ID Governance', 'Entra Verified ID',
      'OAuth 2.0 / OpenID Connect', 'REST APIs',
      'GDPR & ISO 27001', 'Visio',
    ],
  },
  {
    name: 'Languages',
    tags: [
      'English (Full Professional)', 'Arabic (Native)',
      'Russian (Native)', 'French (Elementary)',
    ],
  },
  {
    name: 'Certifications',
    tags: [
      'Microsoft Certified: Security, Compliance, and Identity Fundamentals (SC-900)',
      'Microsoft Certified: Azure AI Fundamentals (AI-900)',
      'Microsoft Certified: Azure Fundamentals (AZ-900)',
      'Professional Scrum Master™ I (PSM I)',
      'Professional Scrum™ with Kanban I (PSK I)',
      'Avaloq Certified Customisation Professional (ACCP)',
      'Learn to Code in Python — Boot.dev',
      'Learn Git — Boot.dev',
      'Learn Linux — Boot.dev',
    ],
  },
];
---

<section id="skills" class="py-28 px-8 flex items-center justify-center">
  <div class="max-w-5xl w-full mx-auto">
    <h2 class="font-heading text-4xl font-bold text-center text-accent mb-14">Skills & Certifications</h2>

    <div class="grid md:grid-cols-2 gap-6">
      {categories.map(cat => (
        <div class="bg-white/5 p-8 rounded-2xl border border-white/5">
          <h3 class="text-accent font-semibold mb-6 text-lg">{cat.name}</h3>
          <div class="flex flex-wrap gap-2.5">
            {cat.tags.map(tag => (
              <span class="bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm border border-accent/20 cursor-default transition-all duration-300 hover:bg-accent hover:text-white">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
