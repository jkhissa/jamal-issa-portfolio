---
---

<section
  id="hero"
  class="min-h-screen flex items-center justify-center text-center pt-20 px-8"
>
  <div class="max-w-4xl w-full mx-auto">
    <h1
      class="glitch-text font-heading font-bold mb-3 bg-gradient-to-r from-white to-[#a5a5a5] bg-clip-text text-transparent"
      style="font-size: clamp(2.8rem, 7vw, 5rem);"
      data-text="Jamal Issa"
    >
      Jamal Issa
    </h1>
    <h2 class="text-2xl text-accent mb-3 font-semibold">Senior Technical Business Analyst</h2>
    <p class="text-lg mb-10 opacity-70">IAM & MS Entra Suite &nbsp;·&nbsp; Avaloq Core &nbsp;·&nbsp; Agile Practitioner</p>

    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="#contact"
        class="px-8 py-3 rounded-full font-semibold bg-accent text-white transition-all duration-300 hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_10px_25px_rgba(100,108,255,0.35)]"
      >
        Get in Touch
      </a>
      <a
        href="#experience"
        class="px-8 py-3 rounded-full font-semibold border-2 border-accent text-accent bg-transparent transition-all duration-300 hover:bg-accent/10 hover:-translate-y-0.5"
      >
        View Experience
      </a>
      <a
        href="https://github.com/jkhissa"
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-3 rounded-full font-semibold border-2 border-accent text-accent bg-transparent transition-all duration-300 hover:bg-accent/10 hover:-translate-y-0.5"
      >
        GitHub
      </a>
    </div>
  </div>
</section>

<script>
  const glitchEl = document.querySelector<HTMLElement>('.glitch-text');
  if (glitchEl) {
    setInterval(() => {
      glitchEl.style.animation = 'none';
      void glitchEl.offsetWidth;
      glitchEl.style.animation = 'glitch 1s infinite';
    }, 3000);
  }
</script>
