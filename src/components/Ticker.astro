---
interface Props { items: string[] }
const { items } = Astro.props;
// Rendered twice so the loop is seamless; the copy is hidden from screen readers.
---

<div class="ticker">
  <p class="visually-hidden">Platforms and standards: {items.join(', ')}</p>
  <div class="track" aria-hidden="true">
    {[0, 1].map(() => (
      <span>{items.map(item => <>{item}<i>●</i></>)}</span>
    ))}
  </div>
</div>

<style>
  .ticker {
    overflow: hidden; white-space: nowrap; padding: 8px 0; border-radius: 10px; line-height: 1;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track { display: inline-flex; }
  span { display: inline-block; font: 500 13px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-2); }
  i { color: var(--accent); font-style: normal; margin: 0 16px; font-size: 8px; vertical-align: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    .track { animation: slide 45s linear infinite; }
  }
  @keyframes slide { to { transform: translateX(-50%); } }
</style>
